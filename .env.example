# URL pública do site (usada em sitemap, canonical e Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.exemplo-aceg.org.br

# ---- Envio dos formulários (contato, voluntariado e parcerias) ----
# Sem estas variáveis o servidor responde 503 e o site informa o visitante com transparência.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remetente (deve pertencer ao domínio/conta SMTP) e destinatários
MAIL_FROM="Site ACEG <no-reply@exemplo-aceg.org.br>"
MAIL_TO_CONTATO=
MAIL_TO_VOLUNTARIADO=
MAIL_TO_PARCERIAS=
# Opcional: um único destinatário para os três formulários
MAIL_TO=

# Antispam embutido (sem serviços externos): campo-armadilha, tempo mínimo de preenchimento,
# validação no servidor, checagem de origem e limite de tentativas por IP.
